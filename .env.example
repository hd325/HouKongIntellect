# Copy to .env and fill credentials locally. Never commit .env.
# Existing environment variables take precedence over this file.

HOUKONG_HOST=127.0.0.1
HOUKONG_PORT=8000
HOUKONG_RELOAD=false
HOUKONG_DATA_DIR=data
# Leave blank to use an isolated store. Windows paths containing non-ASCII
# characters use LOCALAPPDATA/HouKongIntellectPublic/<data-directory-id>/chroma_db.
HOUKONG_CHROMA_DIR=

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
SERPER_API_KEY=

# tfidf runs offline. local needs requirements-local.txt and a downloaded model.
# auto tries Tencent (when configured), local, then tfidf.
EMBEDDING_BACKEND=tfidf
LOCAL_EMBEDDING_MODEL=shibing624/text2vec-base-chinese
